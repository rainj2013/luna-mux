{
  "name": "ssh-client",
  "version": "0.1.0",
  "description": "Cross-platform SSH and SFTP desktop client",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.local.sshclient",
    "productName": "SSH Client",
    "asar": true,
    "files": ["out/**/*", "package.json"],
    "extraResources": [{ "from": "resources/icons", "to": "icons", "filter": ["*.png"] }],
    "directories": { "output": "release" },
    "win": {
      "icon": "resources/icons/ssh.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "files": [
        "!node_modules/ssh2/lib/protocol/crypto/build/**",
        "!node_modules/cpu-features/build/**"
      ]
    },
    "mac": { "icon": "resources/icons/ssh.icns", "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }, { "target": "zip", "arch": ["x64", "arm64"] }], "category": "public.app-category.developer-tools" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
