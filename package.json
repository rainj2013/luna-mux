{
  "name": "luna-mux",
  "version": "0.1.0",
  "description": "A local and remote terminal workspace for coding agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --bundles dmg",
    "build:win": "tauri build --bundles nsis",
    "build:win:webview2": "tauri build --bundles nsis --config app/native/tauri.windows-offline.conf.json",
    "build:win:offline": "tauri build --bundles nsis --config app/native/tauri.windows-offline.conf.json",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "product:sync": "node scripts/sync-product.mjs",
    "product:check": "node scripts/sync-product.mjs --check",
    "runtime:sync": "node scripts/sync-terminal-runtime-contract.mjs",
    "runtime:check": "node scripts/sync-terminal-runtime-contract.mjs --check",
    "runtime:test": "cargo test --manifest-path contracts/rust-tests/Cargo.toml",
    "native-core:test": "cargo test --manifest-path tests/native-core/Cargo.toml",
    "agent-browser:sync": "node scripts/sync-agent-browser-sidecar.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run product:check && npm run runtime:check && npm run icons:check && npm run i18n:check && npm run typecheck && cargo check --manifest-path app/native/Cargo.toml",
    "test": "cargo test --manifest-path app/native/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
